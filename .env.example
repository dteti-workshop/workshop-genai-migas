# ============================================================
# Konfigurasi Workshop GenAI Migas
# Salin file ini menjadi .env, kemudian isi nilainya:
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (macOS/Linux)
# File .env tidak boleh di-commit ke Git.
# ============================================================

# ID peserta: nomor meja dan nama singkat, contoh P07-andi.
# Digunakan untuk memantau pemakaian API key bersama.
PARTICIPANT_ID=P00-nama

# Profil LLM yang aktif: online | local
LLM_PROFILE=online

# --- Profil ONLINE (OpenRouter) ---------------------------------
ONLINE_BASE_URL=https://openrouter.ai/api/v1
ONLINE_API_KEY=isi-dengan-api-key-workshop
# DeepSeek V4 Flash: context window 1 juta token, mode reasoning dapat diatur pada setiap request
ONLINE_MODEL=deepseek/deepseek-v4-flash
# Penyedia model pada OpenRouter, berurutan sesuai prioritas. OpenRouter meneruskan request ke
# salah satu penyedia. Daftar ini membatasi pilihannya agar jumlah token dan hasil konsisten.
ONLINE_PROVIDERS=Novita,Parasail,Alibaba,GMICloud

# --- Profil LOCAL (server model lokal, API OpenAI-compatible) ---
# Contoh Ollama pada laptop sendiri: http://localhost:11434/v1
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=local
LOCAL_MODEL=qwen2.5:7b-instruct

# --- Embedding (Hari 2) ------------------------------------------
# fastembed : model dijalankan pada laptop (CPU), tanpa API
# openai    : endpoint embeddings OpenAI-compatible (server lokal atau online)
EMBED_PROVIDER=fastembed
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Folder cache model fastembed
EMBED_CACHE_DIR=./models
# Hanya digunakan jika EMBED_PROVIDER=openai
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=local

# Mode reasoning default: none | low | medium | high
# Nilai none berarti model menjawab tanpa reasoning tokens.
LLM_REASONING_EFFORT=none

# --- Lain-lain ----------------------------------------------------
# Jumlah request paralel maksimum untuk setiap peserta (API key digunakan bersama)
LLM_MAX_CONCURRENCY=4
# Cache jawaban LLM pada temperature 0 agar pengulangan eksperimen tidak menambah biaya
LLM_CACHE=true
